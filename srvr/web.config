<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <staticContent>
      <!-- Disable IIS client-side caching for ALL static content so WebUI
           changes (index.html, styles.css, app.js, status.json, etc.) appear
           immediately for everyone instead of being served stale from a
           browser/proxy cache. dobinator.c-nav.com is hosted here via IIS. -->
      <clientCache cacheControlMode="DisableCache" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".md" />
      <mimeMap fileExtension=".md" mimeType="text/markdown" />
    </staticContent>

    <!-- Backstop for the clientCache setting above: emit explicit no-store
         headers on EVERY response so no browser or proxy holds a cached copy.
         This applies site-wide, which is why the old per-file status.json
         customHeaders block was removed (re-adding the same header names in a
         <location> would trip an IIS duplicate-entry error, HTTP 500.19). -->
    <httpProtocol>
      <customHeaders>
        <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
        <add name="Pragma" value="no-cache" />
        <add name="Expires" value="0" />
      </customHeaders>
    </httpProtocol>

    <httpErrors errorMode="Detailed" />
  </system.webServer>

  <location path="HostingInstructions.md">
    <system.webServer>
      <security>
        <requestFiltering>
          <hiddenSegments>
            <add segment="HostingInstructions.md" />
          </hiddenSegments>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>

  <location path="srvr_api.py">
    <system.webServer>
      <security>
        <requestFiltering>
          <hiddenSegments>
            <add segment="srvr_api.py" />
          </hiddenSegments>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>

  <location path="srvr_api.log">
    <system.webServer>
      <security>
        <requestFiltering>
          <hiddenSegments>
            <add segment="srvr_api.log" />
          </hiddenSegments>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
