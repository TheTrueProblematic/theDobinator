# Drive Label site: the React SOURCE lives in drivelabel/app and its build output
# in drivelabel/site. site/ is deliberately COMMITTED — the office PC has no
# Node, so the finished files have to arrive via git. Only deps are ignored.
drivelabel/app/node_modules/
drivelabel/app/.vite/


# Secrets — never commit. Holds the GitHub fine-grained PAT used by the update watcher.
configs/keys.json

logs/completedDrives.csv

# Runtime state written by the running system — never commit it. update_state.json
# in particular is rewritten by srvr_api.py's update watcher every couple of
# minutes; committing it would mean `git reset --hard` during an update stomps the
# live state with a stale snapshot.
logs/update_state.json
logs/label_print.json
logs/autostart.flag
logs/update_scheduled.flag
logs/submissions/
